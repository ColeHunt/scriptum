# Shared by both image builds (context = repo root):
#   containers/code/Dockerfile    needs containers/code/, catalog/
#   containers/control/Dockerfile needs package.json, bun.lock, tsconfig*,
#     apps/, packages/, scripts/, catalog/, vendor/, patches/, the
#     submodule gitdir .git/modules/vendor/AdvantageScope (for the
#     AdvantageScope patch/symlink steps), and dist/elastic (a host-prebuilt
#     Flutter output, only for a local build — CI supplies it via
#     --build-context instead).

# Git metadata, except the AdvantageScope submodule gitdir.
.git
!.git/modules/vendor/AdvantageScope

# Dependencies and build outputs (regenerated inside the build stages) —
# except dist/elastic, which is the one exception that's genuine build INPUT,
# not output: the elastic-dist stage copies a host-prebuilt Flutter web build
# (no Flutter SDK in this Dockerfile's own toolchain — see decision 041).
node_modules
**/node_modules
dist
!dist/elastic
apps/web/dist

# Runtime and local-only data.
data
*.env
.env*

# Not used by any image. (*.md is root-level only — catalog lesson READMEs
# under catalog/ still ship in both images. THIRD_PARTY_NOTICES.md is the one
# exception: BSD-3-Clause requires the notice to accompany the binary
# distribution, and the images are that distribution. Extensionless LICENSE is
# not matched by *.md and needs no negation.)
website
docs
dashboards
deploy
e2e
lessons-repo-root
graphify-out
test-results
playwright-report
.github
.claude
*.md
!THIRD_PARTY_NOTICES.md
