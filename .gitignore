# Node
node_modules/
dist/
.npm/
*.tsbuildinfo

# Runtime data. The directory itself is kept (data/.gitkeep) so a fresh clone
# already has it owned by the cloning user — the containerized control plane
# stat()s it to pick the uid:gid workspace containers run as. If Docker had to
# create it at first `docker compose up` it would be root-owned and the
# control plane would refuse to start.
data/*
!data/.gitkeep

# Environment (secrets)
.env
!.env.example

# Gradle / Java
.gradle/
build/
bin/
*.class
*.iml
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# IDEs
.idea/
.vscode/
!catalog/**/.vscode/
!catalog/**/.vscode/*.json
!.wpilib/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Claude Code local
.claude/settings.local.json

# keep graph outputs, skip heavy/local-only files
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_root
graphify-out/.graphify_python

playwright-report/
test-results/

data-alloy/

# Docusaurus site (website/node_modules and website/build are covered above)
website/.docusaurus/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

lessons-repo-root/

# Bundled catalog build artifacts (keep sources, ignore generated output)
catalog/**/build/
catalog/**/bin/
catalog/**/.gradle/
