#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Launches choreo-server, the HTTP/WS sidecar exposing Choreo's trajectory
# editor (replaces PathPlanner - see docs/decisions/040-choreo-integration.md).
# Binds loopback-only; the control plane proxies to it the same way it
# proxies to codium-server and the HALSim bridge.

exec \
  s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z 127.0.0.1 ${CHOREO_PORT:-5900}" \
    s6-setuidgid abc \
      /usr/local/bin/choreo-server
