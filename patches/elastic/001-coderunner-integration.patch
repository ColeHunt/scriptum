diff --git a/lib/services/coderunner_embed.dart b/lib/services/coderunner_embed.dart
new file mode 100644
index 0000000..6cd5a1b
--- /dev/null
+++ b/lib/services/coderunner_embed.dart
@@ -0,0 +1,69 @@
+// CodeRunner integration point.
+//
+// When Elastic is embedded in the CodeRunner browser IDE, it is loaded as
+// `/elastic/?ws=<workspaceSlug>` (see apps/web/src/components/ElasticPane.tsx
+// in the CodeRunner repo). That query parameter is the only signal this file
+// looks at: its presence means NT4 and layout persistence should go through
+// the control plane's authenticated per-workspace routes instead of a LAN
+// robot connection and local browser storage. Standalone desktop/web usage
+// (no `ws` param) is completely unaffected.
+//
+// See patches/elastic/README.md and
+// docs/decisions/041-elastic-dashboard-integration.md in the CodeRunner repo.
+import 'package:http/http.dart' as http;
+
+/// The workspace slug CodeRunner embedded this instance with, or null when
+/// running standalone.
+String? get coderunnerWorkspaceSlug => Uri.base.queryParameters['ws'];
+
+bool get isCoderunnerEmbedded => coderunnerWorkspaceSlug != null;
+
+String _coderunnerOrigin() {
+  Uri base = Uri.base;
+  return '${base.scheme}://${base.authority}';
+}
+
+/// Full NT4 WebSocket URL proxied through the control plane
+/// (`/u/<slug>/sim/nt4`), authenticated by the session cookie that loaded
+/// this page. The `app` query parameter tells the proxy which upstream NT4
+/// client identity to use, so Elastic doesn't share AdvantageScope Lite's.
+String? coderunnerNt4Endpoint() {
+  String? slug = coderunnerWorkspaceSlug;
+  if (slug == null) return null;
+  String scheme = Uri.base.scheme == 'https' ? 'wss' : 'ws';
+  return '$scheme://${Uri.base.authority}/u/$slug/sim/nt4?app=Elastic';
+}
+
+/// Fetches the student's saved layout from their project
+/// (`src/main/deploy/elastic-layout.json`), or null when running standalone,
+/// nothing has been saved yet, or the request fails - callers should fall
+/// back to the normal SharedPreferences-backed layout in every null case.
+Future<String?> coderunnerFetchLayout() async {
+  String? slug = coderunnerWorkspaceSlug;
+  if (slug == null) return null;
+  try {
+    http.Response response = await http
+        .get(Uri.parse('${_coderunnerOrigin()}/u/$slug/api/elastic-layout'))
+        .timeout(const Duration(seconds: 5));
+    if (response.statusCode != 200) return null;
+    return response.body;
+  } catch (_) {
+    return null;
+  }
+}
+
+/// Mirrors a saved layout to the student's project so it rides along with
+/// their robot code in git, same as a real competition deploy. Fire-and-
+/// forget: a network hiccup here should never block the local save the
+/// student already sees succeed via SharedPreferences.
+void coderunnerPersistLayout(String layoutJson) {
+  String? slug = coderunnerWorkspaceSlug;
+  if (slug == null) return;
+  http
+      .put(
+        Uri.parse('${_coderunnerOrigin()}/u/$slug/api/elastic-layout'),
+        headers: {'content-type': 'application/json'},
+        body: layoutJson,
+      )
+      .catchError((_) => http.Response('', 0));
+}
