@@ -437,6 +473,33 @@ async function handleHubMessage(message: NamedMessage) {
         const uuid: string = message.data.uuid;
         const path: string = message.data.path;
 
+        if (path === FRC_SIM_LOG_PATH && frcSimLogUrl !== null) {
+          try {
+            let response = await fetch(frcSimLogUrl);
+            if (!response.ok) throw new Error(response.statusText || "Fetch failed");
+            let buffer = await response.arrayBuffer();
+            let array = new Uint8Array(buffer);
+            sendMessage(hubPort, "historical-data", {
+              files: [array],
+              error: null,
+              uuid: uuid
+            });
+            window.parent.postMessage({ type: "frc-sim:log-ready" }, window.location.origin);
+          } catch (e) {
+            let errorMessage = e instanceof Error ? e.message : "Fetch failed";
+            sendMessage(hubPort, "historical-data", {
+              files: [null],
+              error: errorMessage,
+              uuid: uuid
+            });
+            window.parent.postMessage(
+              { type: "frc-sim:log-error", error: errorMessage },
+              window.location.origin
+            );
+          }
+          break;
+        }
+
         let prefs = DEFAULT_PREFS;
         let prefsRaw = localStorage.getItem(LocalStorageKeys.PREFS);
         if (prefsRaw !== null) mergePreferences(prefs, JSON.parse(prefsRaw));
