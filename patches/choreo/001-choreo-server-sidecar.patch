+//! Streams live solver progress (the in-progress trajectory shape, as it
+//! converges) to the browser over a WebSocket. The desktop build emits these
+//! as Tauri events straight from the progress channel; the sidecar instead
+//! fans the same channel out to every connected `/ws/progress` client via a
+//! broadcast channel, since more than one browser tab could be watching.
+
+use axum::{
+    extract::{
+        State,
+        ws::{Message, WebSocket, WebSocketUpgrade},
+    },
+    response::Response,
+};
+use choreo_core::generation::generate::LocalProgressUpdate;
+use serde::Serialize;
+use tokio::sync::broadcast;
+
+use crate::state::AppState;
+
+/// Local stand-in for `choreo_core::generation::generate::HandledLocalProgressUpdate`,
+/// which derives neither `Clone` nor `Serialize` upstream (it only ever
+/// crossed a Tauri event boundary, which needed neither). Defined here
+/// instead of patching `choreo-core`.
+#[derive(Clone, Debug, Serialize)]
+pub struct ProgressMessage {
+    pub handle: i64,
+    pub update: LocalProgressUpdate,
+}
+
+pub async fn progress_ws(ws: WebSocketUpgrade, State(state): State<AppState>) -> Response {
+    let rx = state.progress.subscribe();
+    ws.on_upgrade(move |socket| handle_socket(socket, rx))
+}
+
+async fn handle_socket(mut socket: WebSocket, mut rx: broadcast::Receiver<ProgressMessage>) {
+    loop {
+        tokio::select! {
+            update = rx.recv() => {
+                match update {
+                    Ok(update) => {
+                        let Ok(text) = serde_json::to_string(&update) else { continue };
+                        if socket.send(Message::Text(text.into())).await.is_err() {
+                            break;
+                        }
+                    }
+                    // A slow client skipped some updates; newer ones still arrive.
+                    Err(broadcast::error::RecvError::Lagged(_)) => continue,
+                    Err(broadcast::error::RecvError::Closed) => break,
+                }
+            }
+            // Only here to notice the client closing the connection (or sending a
+            // ping we don't care about) so this task doesn't outlive the socket.
+            incoming = socket.recv() => {
+                if !matches!(incoming, Some(Ok(_))) {
+                    break;
+                }
+            }
+        }
+    }
+}
