+// CodeRunner iframes this app at /choreo/?ws=<slug> (mirrors how PathPlanner's
+// web build reads its own ?ws= param - see
+// docs/decisions/040-choreo-integration.md on the CodeRunner side). The
+// session cookie on that same origin authenticates every request; the slug
+// only selects which workspace's choreo-server the control plane proxies to.
+const workspaceSlug = new URLSearchParams(window.location.search).get("ws");
+
+export const API_BASE = workspaceSlug
+  ? `/u/${workspaceSlug}/api/choreo`
+  : "";
diff --git a/src/document/progressSocket.ts b/src/document/progressSocket.ts
new file mode 100644
index 0000000..de2c607
--- /dev/null
+++ b/src/document/progressSocket.ts
@@ -0,0 +1,78 @@
+// Replaces the desktop build's Tauri event listener (`listen("solver-status-
+// ${handle}", ...)`, emitted from the progress channel in src-tauri/src/
+// tauri.rs) with a WebSocket to choreo-server's /ws/progress, which the
+// control plane proxies the same way it proxies codium-server and HALSim.
+// choreo-server broadcasts every active generation's updates to all
+// connected clients tagged with {handle, update}; this module is the one
+// place that demultiplexes by handle, so call sites keep the same shape
+// (subscribe, get an unlisten function back) that `listen()` had.
+import { API_BASE } from "./apiBase";
+import { ProgressUpdate } from "./schema/DocumentTypes";
+
+type ProgressMessage = { handle: number; update: ProgressUpdate };
+
+let socket: WebSocket | null = null;
+const listenersByHandle = new Map<number, Set<(update: ProgressUpdate) => void>>();
+
+function ensureSocket(): WebSocket {
+  if (
+    socket &&
+    (socket.readyState === WebSocket.OPEN ||
+      socket.readyState === WebSocket.CONNECTING)
+  ) {
+    return socket;
+  }
+  const proto = window.location.protocol === "https:" ? "wss:" : "ws:";
+  const ws = new WebSocket(
+    `${proto}//${window.location.host}${API_BASE}/ws/progress`
+  );
+  ws.addEventListener("message", (event) => {
+    if (typeof event.data !== "string") return;
+    let parsed: ProgressMessage;
+    try {
+      parsed = JSON.parse(event.data);
+    } catch {
+      return;
+    }
+    listenersByHandle.get(parsed.handle)?.forEach((cb) => cb(parsed.update));
+  });
+  ws.addEventListener("close", () => {
+    if (socket === ws) socket = null;
+  });
+  socket = ws;
+  return ws;
+}
+
+/**
+ * Subscribes to progress updates for one generation handle. Resolves once
+ * the connection is actually open, matching `listen()`'s contract that the
+ * listener is registered before the caller starts the generation it's
+ * watching - otherwise early updates could arrive before anyone is
+ * listening and be silently dropped (broadcast channels don't buffer for
+ * late subscribers).
+ */
+export function subscribeToProgress(
+  handle: number,
+  callback: (update: ProgressUpdate) => void
+): Promise<() => void> {
+  return new Promise((resolve) => {
+    const ws = ensureSocket();
+    let set = listenersByHandle.get(handle);
+    if (!set) {
+      set = new Set();
+      listenersByHandle.set(handle, set);
+    }
+    set.add(callback);
+    const unlisten = () => {
+      set?.delete(callback);
+      if (set && set.size === 0) {
+        listenersByHandle.delete(handle);
+      }
+    };
+    if (ws.readyState === WebSocket.OPEN) {
+      resolve(unlisten);
+    } else {
+      ws.addEventListener("open", () => resolve(unlisten), { once: true });
+    }
+  });
+}
