+#[derive(Deserialize)]
+pub struct DeleteCodegenFileRequest {
+    pub project: ProjectFile,
+    pub filename: String,
+}
+
+/// Deletes a generated codegen file (e.g. when a student turns off "generate
+/// vars file"). Resolves the path the same way gen_traj_data_file/
+/// gen_vars_file do - the frontend has no filesystem of its own to compute
+/// an absolute path with, unlike the desktop build (which used Tauri's own
+/// path APIs against getDeployRoot()).
+pub async fn delete_codegen_file(
+    State(state): State<AppState>,
+    Json(req): Json<DeleteCodegenFileRequest>,
+) -> Result<(), ApiError> {
+    if let Some(codegen_root) = req.project.codegen.get_root() {
+        let deploy_root = state.writing.get_deploy_path().await?;
+        let file_path = deploy_root
+            .join(codegen_root)
+            .join(format!("{}.java", req.filename));
+        if let Ok(exists) = fs::exists(&file_path)
+            && !exists
+        {
+            return Ok(());
+        }
+        fs::remove_file(file_path).map_err(ChoreoError::from)?;
+    }
+    Ok(())
+}
+
