+
+/// Finds the first `.chor` project file in the deploy directory, if any.
+///
+/// The desktop app opens a project the user explicitly picks via a native
+/// file dialog; a hosted browser IDE has exactly one project per workspace
+/// (its fixed deploy root) and no dialog to pick with, so this discovers
+/// whatever is already there instead.
+pub async fn find_project_name(resources: &WritingResources) -> Option<String> {
+    let deploy_dir = resources.root.lock().await.clone();
+    let mut dir = fs::read_dir(&deploy_dir).await.ok()?;
+    while let Ok(Some(entry)) = dir.next_entry().await {
+        let path = entry.path();
+        if let Some(extension) = path.extension()
+            && extension.eq_ignore_ascii_case("chor")
+            && let Some(name) = path.file_stem().map(|p| p.to_string_lossy())
+        {
+            return Some(name.to_string());
+        }
+    }
+    None
+}
